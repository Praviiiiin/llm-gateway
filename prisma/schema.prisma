// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ApiKeyStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

model ApiKey {
  id         String       @id @default(cuid())
  identifier String       @unique
  keyHash    String
  status     ApiKeyStatus @default(ACTIVE)
  createdAt  DateTime     @default(now())
  revokedAt  DateTime?
  expiresAt  DateTime?
  requests   LlmRequest[]
}

enum ProviderStatus {
  ACTIVE
  INACTIVE
}

model LlmProvider {
  id             String         @id @default(cuid())
  name           String         @unique
  baseUrl        String?
  status         ProviderStatus @default(ACTIVE)
  createdAt      DateTime       @default(now())
  requests       LlmRequest[]   @relation("RequestProvider")
  cachedRequests LlmRequest[]   @relation("CachedProvider")
}

enum RequestStatus {
  PENDING
  SUCCESS
  FAILED
  TIMEOUT
}

model LlmRequest {
  id String @id @default(cuid())

  apiKeyId String?
  apiKey   ApiKey? @relation(fields: [apiKeyId], references: [id])

  providerId String?
  provider   LlmProvider? @relation("RequestProvider", fields: [providerId], references: [id])

  cachedFromProviderId String?
  cachedFromProvider   LlmProvider? @relation("CachedProvider", fields: [cachedFromProviderId], references: [id])

  model    String
  status   RequestStatus @default(PENDING)
  cacheHit Boolean       @default(false)

  inputTokens   Int      @default(0)
  outputTokens  Int      @default(0)
  estimatedCost Decimal? @default(0) @db.Decimal(12, 8)

  latencyMs Int?
  errorCode String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([apiKeyId])
  @@index([providerId])
  @@index([status])
  @@index([createdAt])
}
